.top-fan {
  display: block;
  width: 525rpx;
  height: 525rpx;
  margin: 30px auto;
  background-image: radial-gradient(circle, rgba(91, 155, 248, 0.25), transparent 72%);
  animation: spin 1s linear infinite;
}

.fan-config-area {
  display: flex;
  margin-bottom: 30px;
}

.config-item {
  text-align: center;
  width: 33%;
  border-right: 1px solid var(--main-border-color);
  display: flex;
  flex-direction: column;
}

.config-item-title {
  font-size: 12px;
  color: var(--main-title-color);
  margin-bottom: 10px;
}

.config-left-title {
  display: flex;
  align-items: center;
}

.config-list-area {
  background-color: var(--main-card-bg-color);
  border-radius: 16px;
  box-shadow: var(--main-card-shadow);
  margin: 8px;
  padding: 15px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 80px;
}

.config-list-icon-wrp {
  width: 50px;
  height: 50px;
  background: rgba(75, 177, 152, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
}

.config-list-icon-wrp-active {
  background: rgba(75, 177, 152, 1);
}

.config-rock-top-area {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.config-list-icon {
  width: 30px;
  height: 30px;
}

.config-right-area {
  display: flex;
  align-items: center;
}

.config-right-icon {
  margin-left: 25px;
  width: 25px;
}

.switch-btn {
  width: 33%;
  text-align: center;
}

.rock-btn-wrp {
  width: 33%;
  margin-top: 20px;
  text-align: center;
}

.rock-btn {
  width: 90%;
  display: inline-block;
  height: 40px;
  text-align: center;
  border-radius: 50px;
  line-height: 40px;
  background-color: rgba(75, 177, 152, 0.2);
  color: rgb(75, 177, 152);
}

.rock-btn-active {
  background-color: rgba(75, 177, 152, 1);
  color: #191919;
}

.container-view-wrp {
  padding: 15px 15px 50px;
}

.container-view-title {
  text-align: center;
}

.container-view-num {
  font-size: 50px;
  text-align: center;
  margin: 40px 0;
}

.slider-wrp {
  display: flex;
  align-items: center;
  margin: 0 20px;
  font-size: 30px;
  color: var(--main-text-color);
}

.slider-icon {
  width: 20px;
  height: 20px;
}

.container-slider {
  margin: 0 20px;
  flex: 1;
}

.container-btn-wrp {
  display: flex;
  width: 100%;
  margin-top: 30px;
  justify-content: space-between;
}

.btn-right {
  width: 48%;
}

.btn-left {
  background-color: var(--plus-BG-3);
  color: var(--main-text-color);
  width: 48%;
}

.border0 {
  border: 0;
}

.w100 {
  width: 100%;
}

.pb20 {
  padding-bottom: 20px;
}

.flex-column {
  flex-direction: column;
}

:root[theme='dark'] .top-fan {
  background-image: radial-gradient(circle, rgba(76, 145, 241, 0.22), transparent 72%);
  filter: drop-shadow(0 0 12px rgba(121, 181, 255, 0.22));
}

.config-item-subtitle,
.container-view-num {
  color: var(--main-accent-color);
  font-variant-numeric: tabular-nums;
}

:root[theme='dark'] .slider-icon,
:root[theme='dark'] .config-right-icon {
  filter: brightness(0) invert(0.8);
}

:root[theme='dark'] .rock-btn {
  color: #8fe6cd;
}

:root[theme='dark'] .rock-btn-active {
  background-color: #8fe6cd;
  color: #17382f;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}
