<mptabs
  tabs="{{tabs}}"
  activeTab="{{activeTab}}"
  swiperClass="plus-tabs-swiper"
  tabBackgroundColor="var(--main-card-bg-color)"
  tabActiveTextColor="var(--main-text-color)"
  tabInactiveTextColor="var(--main-title-color)"
  bindtabclick="onTabCLick"
  bindchange="onChange"
  activeClass="tab-bar-title__selected"
>
  <view ty:for="{{tabs}}" ty:key="title" slot="tab-content-{{index}}">
    <tyList></tyList>
  </view>
</mptabs>
